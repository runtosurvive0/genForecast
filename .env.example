# Optional local frontend settings. Real .env/.env.local files stay out of Git.
MIDTERM_DEV_PORT=5173
MIDTERM_API_TARGET=http://127.0.0.1:8093

# Historical PostgreSQL collection only; saved forecasts do not need a DSN.
# Python reads this from its process environment, not automatically from .env.
MIDTERM_SOURCE_DSN=

# AISstream key belongs ONLY in the Python server process environment.
# Python does not automatically load this frontend .env file. See docs/VESSEL_API.md.
# AISSTREAM_API_KEY=
# Optional server JSON bounding boxes; default covers the world, not only Korea.
# AISSTREAM_BOUNDING_BOXES=[[[-90,-180],[90,180]]]

# GFW past port visits: Python server environment only, never VITE_ or browser storage.
# Register a noncommercial API token; Python does not load this file automatically.
# GFW_API_TOKEN=
